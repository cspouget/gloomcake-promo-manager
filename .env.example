# Required: private Release Agent password (choose a long random value)
AGENT_ACCESS_KEY=

# Required: OpenAI API key for creative direction + artwork generation
OPENAI_API_KEY=

# Automatically injected by a connected Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Required for standalone Metricool scheduling + analytics
METRICOOL_API_TOKEN=

# GloomCake Metricool defaults; override only if the brand changes
METRICOOL_USER_ID=5303244
METRICOOL_BLOG_ID=6885961
METRICOOL_TIMEZONE=America/New_York

# Recommended: protects Vercel Cron analytics endpoint
CRON_SECRET=

# Optional fallback; normally upload the exact logo at /agent/setup instead
GLOOMCAKE_LOGO_URL=
